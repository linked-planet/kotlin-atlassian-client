<?xml version="1.0" encoding="UTF-8"?>

<!--
  This settings file overrides the default user settings file. This way all required dependencies can be resolved using
  the atlassian-public repository as a mirror for the central repository.
-->

<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>defaultProfile</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>maven-central</id>
          <name>Maven Central</name>
          <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
          <id>atlassian-proxy</id>
          <name>Atlassian Maven 2 Proxy</name>
          <url>https://packages.atlassian.com/artifactory/maven-atlassian-all/ </url>
        </repository>
        <repository>
          <id>terracotta</id>
          <name>Terracotta</name>
          <url>https://repo.terracotta.org/maven2/</url>
        </repository>
        <repository>
          <id>jenkins-releases</id>
          <name>Jenkins</name>
          <url>https://repo.jenkins-ci.org/releases/</url>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>maven-central</id>
          <name>Maven Central</name>
          <url>https://repo1.maven.org/maven2/</url>
        </pluginRepository>
        <pluginRepository>
          <id>atlassian-proxy</id>
          <name>Atlassian Maven 2 Proxy</name>
          <url>https://packages.atlassian.com/maven/repository/public</url>
        </pluginRepository>
      </pluginRepositories>

      <properties>
        <downloadSources>true</downloadSources>
        <downloadJavadocs>true</downloadJavadocs>
      </properties>
    </profile>
  </profiles>

  <servers>
    <server>
      <id>central</id>
      <username>${env.SONATYPE_USERNAME}</username>
      <password>${env.SONATYPE_PASSWORD}</password>
    </server>
  </servers>
</settings>
